<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_gravity="center"
    android:padding="20dp"
    android:background="#999494">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="25dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="♛"
        android:textColor="#454435"
        android:textSize="60sp"
        android:layout_gravity="center"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BarberSmart"
        android:textSize="34dp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:textColor="#416881"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="35dp"
        android:text="❖Salon M7md | صـالـون مـحـمـد❖
 "
        android:textColor="#000000"
        android:textSize="25dp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/Passord"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text=" تسجيل دخول  "
        android:textSize="20dp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#000000"
        android:layout_marginBottom="25dp"
        />
      <EditText
          android:id="@+id/phoneNumber"
          android:layout_width="match_parent"
          android:layout_height="55dp"
          android:text=" رقم الهاتف  :  "
          android:inputType="phone"
          android:textColor="#161010"
          android:textColorHint="#0F0404"
          android:padding="12dp"
          android:backgroundTint="#000000"
          />

        <EditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="  : كلمه مرور   "
            android:gravity="left"
            android:textColorHint="@color/black"
            android:textColor="@color/black"
            android:padding="12dp"
            android:backgroundTint="@color/black"
            android:layout_marginBottom="25dp"
            />

    <Button
        android:id="@+id/logingButton"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="  دخول  "
        android:textSize="20dp"
        android:textColor="#000000"
        android:backgroundTint="#D9A441"
        android:layout_marginBottom="25dp"
         />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" او "
        android:textSize="20dp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:textColor="#000000"
        android:layout_marginBottom="10dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"/>

    <Button
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_weight="1"
        android:text="Google"
        android:textSize="20dp"

        android:textColor="#000000"
        android:backgroundTint="#D9A441"
        android:layout_marginBottom="25dp"
       />

    <Button
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_weight="1"
        android:text="Apple"
        android:textSize="20dp"
        android:textColor="#000000"
        android:backgroundTint="#D9A441"
        android:layout_marginBottom="25dp"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ليس لديك حساب سجل الان ؟ "
        android:textSize="20dp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:textColor="#000000"
        android:layout_marginBottom="35dp"
        />
</LinearLayout>
